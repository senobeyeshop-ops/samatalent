# ------------------------------------------------------------------
# Sama Talent — variables d'environnement (MODÈLE, SANS VALEURS)
# Copier en .env.local pour le développement (jamais versionné).
# En production : les saisir dans Netlify > Site configuration > Environment variables.
# Règle 20 : .env.local pointe sur le projet Supabase DE TEST (samatalent-dev),
#            Netlify production pointe sur samatalent-prod.
# ------------------------------------------------------------------

# Adresse publique de l'app (sert aux liens de connexion et au contrôle d'origine)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — ces deux-là sont publiques par conception (protégées par la RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — SECRÈTE : contourne la RLS. Serveur uniquement. Jamais NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Sel pour hacher IP/emails dans la limitation de débit (32+ caractères aléatoires)
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=

# --- Étapes suivantes (pas utilisées par la tranche verticale) ---
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
GROQ_API_KEY=
RESEND_API_KEY=
