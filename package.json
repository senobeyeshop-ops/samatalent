{
  "name": "samatalent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings tests/*.test.ts",
    "check:packages": "node scripts/check-packages.mjs",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "check:secrets:build": "node scripts/scan-secrets.mjs --build",
    "audit:deps": "npm audit --audit-level=high",
    "verify": "npm run typecheck && npm run lint && npm test && npm run check:secrets && npm run audit:deps",
    "db:test": "psql \"$TEST_DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/stub.sql -f supabase/migrations/0001_init.sql -f supabase/migrations/0002_photos_annonces_signalements.sql && psql \"$TEST_DATABASE_URL\" -f supabase/tests/securite.sql -f supabase/tests/securite_0002.sql"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
